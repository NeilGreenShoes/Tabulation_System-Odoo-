<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_tabulation_dashboard" model="ir.ui.view">
        <field name="name">tabulation.dashboard.view</field>
        <field name="model">tabulation.dashboard</field>
        <field name="arch" type="xml">
            <form js_class="tabulation_dashboard_js" create="0" edit="0" delete="0" string="Dashboard">
                <!-- <sheet> -->
                    <div class="o_tabulation_dashboard start-0 w-100 h-100 bg-light p-4 overflow-auto">

                        <div class="row align-items-center mb-4 pb-2 border-bottom">
                            <div class="col">
                                <h4 class="fw-bold text-dark m-0">Tabulation Live Dashboard</h4>
                            </div>
                        </div>

                        <div class="col-12 mb-4">
                            <div class="card shadow-sm border-0 h-100 row">
                                <!-- <div class="card-header bg-white border-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                                    <h5 class="card-title mb-0 fw-bold text-dark">Live Sessions</h5>
                                    <span class="badge bg-info-soft text-info">Real-time Updates</span>
                                </div> -->
                                <div class="card-body">
                                    <div class="sessions d-flex flex-wrap gap-3 align-items-stretch w-100">
                                        <div class="text-center p-5 text-muted">
                                            <i class="oi oi-clock fs-1 mb-2 block text-opacity-25"></i>
                                            <p class="mb-0">Waiting for session initialization...</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
    
                        <div class="row g-4 mb-4">
                            <div class="col-12 col-xl-6">
                                <div class="card shadow-sm">
                                    <div class="card-body">
                                        <h6 class="text-muted text-uppercase small fw-bold mb-3">Available Events</h6>
                                        <div class="events g-3">
                                            <div class="col-12">
                                                <span class="text-muted small">No active events</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 col-xl-6">
                                <div class="card shadow-sm ">
                                    <div class="card-body">
                                        <h6 class="text-muted text-uppercase small fw-bold mb-3">Registered Teams</h6>
                                        <div class="teams g-3">
                                            <div class="col-12">
                                                <span class="text-muted small">No teams registered</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                            <!-- <div class="col-12 col-md-6 col-lg-3">
                                <div class="card shadow-sm border-0 h-100 bg-primary text-white">
                                    <div class="card-body d-flex flex-column justify-content-between">
                                        <h6 class="text-uppercase small fw-bold text-white-50">Live Tabulation Status</h6>
                                        <h3 class="fw-bold mb-0">Active</h3>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 col-md-6 col-lg-3">
                                <div class="card shadow-sm border-0 h-100 bg-dark text-white">
                                    <div class="card-body d-flex flex-column justify-content-between">
                                        <h6 class="text-uppercase small fw-bold text-white-50">System Refresh</h6>
                                        <h3 class="fw-bold mb-0 small text-success">● Connected</h3>
                                    </div>
                                </div>
                            </div> -->

                        <div class="row g-4">
                            
                            

                            <div class="col-12">
                                <div class="card shadow-sm border-0 h-100">
                                    <!-- <div class="card-header bg-white border-0 pt-4 pb-0">
                                        <h5 class="card-title mb-0 fw-bold text-dark">Current Standings</h5>
                                    </div> -->
                                    <div class="card-body">
                                        <div class="standings">
                                            <div class="text-center p-5 text-muted">
                                                <i class="oi oi-trophy fs-1 mb-2 block text-opacity-25"></i>
                                                <p class="mb-0">No standings calculated yet.</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                <!-- </sheet> -->
            </form>
        </field>
    </record>

    <record id="view_tabulation_session_wizard_form" model="ir.ui.view">
        <field name="name">tabulation.session.wizard.form</field>
        <field name="model">tabulation.session.wizard</field>
        <field name="arch" type="xml">
            <form string="Session Operations">
                <sheet>
                    <field name="session_id" invisible="1"/>

                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="event_id" string="Event"/>
                        <field name="stage_id" string="Status"/>
                    </group>
                    <sheet string="Judges">
                        <list>
                            <field name="judge_id"/>
                        </list>
                    </sheet>
                </sheet>
                <footer>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dashboard_view" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">tabulation.dashboard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_tabulation_dashboard"/>
        <field name="target">current</field>
    </record>

</odoo>