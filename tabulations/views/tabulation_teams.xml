<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tabulation_teams_kanban" model="ir.ui.view">
        <field name="name">tabulation.teams.kanban</field>
        <field name="model">tabulation.teams</field>
        <field name="arch" type="xml">
            <kanban class="o_res_partner_kanban" sample="1">
                <field name="id"/>
                <field name="team_leader"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                            <div class="oe_kanban_details d-flex flex-column">
                                <strong class="o_kanban_record_title oe_partner_heading">
                                    <field name="team_name"/>
                                </strong>
                                <div class="d-flex align-items-baseline text-break">
                                    <i class="fa fa-trophy mr-2" title="Score"/>
                                    <field name="score"/> 
                                    pts.
                                    <!-- <field name="total_event_scores"/> pts. -->
                                </div>
                                <!-- <button string="Refresh Calculation" action="action_refresh_calculation" type="object" class="btn btn-primary"/> -->
                            </div>
                        </div>
                    </t>
                </templates> 
            </kanban>
        </field>
    </record>

    <record id="view_tabulation_teams_form" model="ir.ui.view">
        <field name="name">tabulation.teams.form</field>
        <field name="model">tabulation.teams</field>
        <field name="arch" type="xml">
            <form >
                <sheet class="w-100 mw-100 px-4 m-0">
                    <div class="oe_title">
                        <h1>
                            <field name="team_name" placeholder="Team Name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="team_leader"/>
                    </group>
                    <group >
                        <field name="team_banner" widget="image" string="Team Banner"/>
                    </group>
                    <group>
                        <field name="active" string="is Active"/>
                    </group>
                    <notebook>
                        <page name="members" string="Team Members">
                            <field name="member_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>

                        <page name="events" string="Participating in Events">
                            <tree editable="bottom">
                                <field name="event_ids"/>
                            </tree>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_teams" model="ir.actions.act_window">
        <field name="name">Teams</field>
        <field name="res_model">tabulation.teams</field>
        <field name="view_mode">kanban,list,form,graph</field>
        <field name="view_id" ref="view_tabulation_teams_kanban"/>
    </record>
</odoo>